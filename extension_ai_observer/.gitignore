*.db
*.sqlite

# Uploads
uploads/

# Misc
# The blanket image rules exist to keep dataset frames and scratch screenshots
# out of the repo. They are NOT meant to catch authored UI assets, and they were
# silently excluding two sets that the app cannot run without.
*.jpg
*.png
*.jpeg

# Authored UI assets — required at runtime, so they must be tracked.
# manifest.json declares the three icon sizes by name; without them Chrome
# refuses to load the unpacked extension. The brand logo is referenced by five
# components via /brand/, so an untracked copy means a clean clone builds
# successfully and then renders broken images.
!extension/assets/*.png
!safe-test-dashboard/public/brand/*.png
