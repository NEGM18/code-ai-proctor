# procminds (safetest.space) — Environment Configuration
# Copy to .env.local and fill in values. Vite only exposes VITE_-prefixed
# vars to client code; the CLOUDFLARE_* vars below are read by the wrangler
# CLI itself (deploy-time), never bundled into the app.

# Supabase (public anon key — safe to expose client-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=change-me

# Google OAuth — read by the `supabase` CLI for the LOCAL stack only
# (`[auth.external.google]` in ../supabase/config.toml). The hosted project
# takes the same two values from Dashboard -> Authentication -> Providers ->
# Google; nothing here reaches it. NOT VITE_-prefixed on purpose: the secret
# must never enter the browser bundle.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=change-me
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=change-me

# Cloudflare — read automatically by `wrangler` from the environment.
CLOUDFLARE_ACCOUNT_ID=change-me
CLOUDFLARE_API_TOKEN=change-me
# Do NOT set this to "procminds" for routine use. Production project name
# lives only in the `deploy:prod` script below, gated behind an explicit
# flag so a bare `npm run deploy` can never reach it.
CLOUDFLARE_PROJECT_NAME=procminds-preview
