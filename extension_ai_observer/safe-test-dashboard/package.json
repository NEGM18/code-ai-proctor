{
	"name": "safe-test-dashboard",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"lint": "eslint . --ignore-pattern \"public/**\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"check:vision-sync": "node scripts/check-vision-sync.mjs",
		"fetch:model": "node scripts/fetch-model.mjs",
		"postinstall": "node scripts/copy-mediapipe-wasm.mjs",
		"preview": "npm run build && wrangler pages dev",
		"deploy": "npm run build && wrangler pages deploy --project-name=procminds-preview",
		"deploy:prod": "echo 'BLOCKED: production (procminds.com) is running the launch countdown. Do not deploy until explicitly told the countdown is over.' && exit 1",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@mediapipe/tasks-vision": "^1.0.1",
		"@supabase/ssr": "^0.12.4",
		"@supabase/supabase-js": "^2.112.0",
		"@tailwindcss/vite": "^4.3.3",
		"lucide-react": "^1.28.0",
		"motion": "^12.43.0",
		"posthog-js": "^1.427.2",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@eslint/js": "^10.0.1",
		"@rolldown/plugin-babel": "^0.2.3",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitest/coverage-v8": "^4.1.10",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^10.6.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"globals": "^17.7.0",
		"jsdom": "^29.1.1",
		"vite": "^8.1.1",
		"vitest": "^4.1.10",
		"wrangler": "^4.35.0"
	}
}
