# AI Observer — Environment Configuration
# Copy to .env and fill in values

# Database: SQLite (local, zero-cost), XAMPP MySQL (local), or Azure SQL (remote)
# For SQLite (recommended for self-hosting):
# DB_CONNECTION_STRING=sqlite:///./ai_observer.db

# For XAMPP MySQL (Local database):
# If running native python:
DB_CONNECTION_STRING=mysql+pymysql://root:@127.0.0.1:3306/ai_observer_db
# If running inside Docker:
# DB_CONNECTION_STRING=mysql+pymysql://root:@host.docker.internal:3306/ai_observer_db

# For Azure SQL (if keeping cloud DB):
# DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=...;Database=...;Uid=...;Pwd=...;

# CORS — comma-separated. Defaults to localhost only if unset (safe for
# local dev). Production should set:
# CORS_ORIGINS=https://procminds.com,https://www.procminds.com
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Proctoring
PROCTOR_API_KEY=change-me-to-a-strong-key
PROCTOR_CHEAT_THRESHOLD=0.80
PROCTOR_BATCH_SIZE=8
PROCTOR_DEVICE=cuda

# Cloudflare (consumed by the wrangler CLI, not by the FastAPI app).
# Wrangler reads CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID from the
# environment automatically for any `wrangler` command run in this repo.
# The actual Pages project lives in safe-test-dashboard/ (see its own
# .env.example) — these are duplicated here only so CI configured at the
# repo root can pick them up too.
CLOUDFLARE_ACCOUNT_ID=change-me
CLOUDFLARE_API_TOKEN=change-me
# Production project name is "procminds". Day-to-day/test deploys must
# target CLOUDFLARE_PROJECT_NAME=procminds-preview instead — see
# safe-test-dashboard/wrangler.jsonc for why the default deploy script is
# hardcoded to preview.
CLOUDFLARE_PROJECT_NAME=procminds-preview
